    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.7",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "rss-parser": "^3.13.0"
  }
}
